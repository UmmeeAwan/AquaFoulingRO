{
  "info": {
    "name": "Aqua Fouling RO",
    "description": "Assessment API \u2014 CSV-first forecast + assisted mapping + batch.\n\nOptional multipart response_format=json|csv (default json). CSV downloads: Save Response in Postman (Send and Download).\nErrors stay JSON even when csv was requested.\nbase_url default http://localhost:8000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /health",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('liveness ok', () => pm.expect(b.status).to.eql('ok'));",
              "pm.test('no phase field', () => pm.expect(b).to.not.have.property('phase'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      }
    },
    {
