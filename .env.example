# Optional Aqua Fouling RO settings (all prefixed AQUA_).
# Copy to `.env` only if you need local overrides. The default demo needs no .env.
#
# Precedence: process environment > .env > configs/forecast_serving.yaml > defaults.
#
# Docker Compose: keys listed under `environment:` in docker-compose.yml are
# injected into the *container* process environment (they win over image ENV and
# over a host `.env` that Compose uses only for *compose-file substitution*
# like ${VAR}). A host `.env` is NOT automatically mounted into the container
# unless you add `env_file:` — prefer explicit `environment:` for serving knobs.
#
# After changing artifact_path or serving limits, restart the API process.

# Bind address / port for `aqua serve` / uvicorn
# AQUA_HOST=0.0.0.0
# AQUA_PORT=8000
# AQUA_LOG_LEVEL=info

# Trained model artifact (server-side only; never accepted from HTTP callers)
# AQUA_ARTIFACT_PATH=artifacts/models/llt_relative_health_v1.json

# Optional path to serving YAML (defaults to configs/forecast_serving.yaml)
# AQUA_SERVING_CONFIG=configs/forecast_serving.yaml

# Default adapter mapping when callers omit multipart `mapping`
# AQUA_DEFAULT_MAPPING=configs/canonical_generic_schema.yaml

# Forecast policy (must match documented limits)
# AQUA_DEFAULT_HORIZON_DAYS=14
# AQUA_MIN_HORIZON_DAYS=1
# AQUA_MAX_HORIZON_DAYS=30
# AQUA_DEFAULT_THRESHOLD_RELATIVE_HEALTH=0.85
# AQUA_MIN_THRESHOLD_RELATIVE_HEALTH=0.50
# AQUA_MAX_THRESHOLD_RELATIVE_HEALTH=0.99
# AQUA_MIN_HISTORY_DAYS=21
# AQUA_MIN_HISTORY_OBSERVATIONS=5
# AQUA_MAX_UPLOAD_BYTES=5242880
# AQUA_MAX_CSV_ROWS=5000
# AQUA_MAX_BATCH_SERIES=50
